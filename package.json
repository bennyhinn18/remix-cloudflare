{
  "name": "@bennyhinn18/remix-cloudflare",
  "version": "0.1.0",
  "description": "Blazing fast, lightweight Cloudflare Workers and Pages adapter for Remix 3",
  "author": "Benny Hinn <bennyhinn18>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bennyhinn18/remix-cloudflare.git"
  },
  "bugs": {
    "url": "https://github.com/bennyhinn18/remix-cloudflare/issues"
  },
  "homepage": "https://github.com/bennyhinn18/remix-cloudflare#readme",
  "keywords": [
    "remix",
    "remix-3",
    "cloudflare",
    "cloudflare-workers",
    "cloudflare-pages",
    "edge",
    "adapter"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "remix": "^3.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241004.0",
    "remix": "^3.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3"
  }
}
